APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Initial admin accounts created by AdminUserSeeder (random if empty outside local)
SEED_ADMIN_PASSWORD=
SEED_MODERATOR_PASSWORD=

# Online payments — docs/payments/PAYMENTS.md
# Payme Business (Merchant API): cashbox id, key and sandbox TEST_KEY from business.payme.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
# true: TEST_KEY is accepted and students go to test.paycom.uz; set false to go live
PAYME_TEST_MODE=true
PAYME_ACCOUNT_FIELD=order_id
# optional: return page ("{order}" = order public id), default /payments/orders/{order}
PAYME_RETURN_URL=
# optional: accept requests only from Payme's 185.234.113.1-15 (needs correct proxy/TrustProxies setup)
PAYME_IP_CHECK=false
# optional fiscal receipt data (IKPU / package code from tasnif.soliq.uz)
PAYME_IKPU_CODE=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=0

# Click (SHOP API): from the Click merchant cabinet (merchant.click.uz)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_RETURN_URL=
CLICK_IP_CHECK=false
CLICK_ALLOWED_IPS=

# false: refunds (CancelTransaction after payment) are refused with -31007
PAYMENT_REVERSE_ON_REFUND=true

# --- exam: AI draft generator (stage 4) — docs/exam/INTEGRATIONS.md ---
# Empty key = AI drafting is off (runs are logged as "skipped", nothing is sent)
ANTHROPIC_API_KEY=
EXAM_AI_MODEL=claude-opus-5-5
EXAM_AI_EFFORT=high
# true: keep the AI's own answer guess as a hidden hint for the reviewer
EXAM_AI_STORE_HINT=false
EXAM_AI_WEEKLY_ENABLED=true
EXAM_AI_WEEKLY_TARGET=100
EXAM_AI_WEEKLY_BUDGET_USD=15

# --- exam: Telegram bot + Mini App (stage 6) — docs/exam/INTEGRATIONS.md ---
# Empty token = bot is off (webhook answers 404, no message is sent)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# random 32+ chars [A-Za-z0-9_-]; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# optional, default {APP_URL}/telegram/app (must be HTTPS for Telegram)
TELEGRAM_MINI_APP_URL=
TELEGRAM_INIT_DATA_TTL=86400
